{
  "name": "prestes",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @prestes/game dev",
    "build": "pnpm --filter @prestes/game build",
    "preview": "pnpm --filter @prestes/game preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:locales": "tsx tools/check-locales.ts",
    "check:content": "tsx tools/check-content.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:locales && pnpm check:content && pnpm check:maps",
    "check:bundle": "tsx tools/check-bundle.ts",
    "check:determinism": "tsx tools/check-determinism.ts",
    "check:difficulty": "tsx tools/check-difficulty.ts",
    "maps:previews": "tsx tools/map-previews.ts",
    "maps:accept": "tsx tools/maps-accept.ts",
    "thumbs": "tsx tools/section-thumbs.ts",
    "verify": "tsx tools/verify.ts",
    "verify:quick": "tsx tools/verify.ts --quick",
    "e2e": "playwright test",
    "sim": "tsx tools/headless-sim.ts",
    "bench": "tsx tools/sim-bench.ts",
    "check:budget": "tsx tools/sim-bench.ts --budget",
    "battle:report": "tsx tools/battle-report.ts",
    "models": "tsx tools/prepare-models.ts",
    "optimize:music": "tsx tools/optimize-gramophone.ts",
    "cut:audio": "tsx tools/cut-audio-sources.ts",
    "prepare:audio": "tsx tools/prepare-audio.ts",
    "icons": "tsx tools/export-icons.ts",
    "hud-art": "tsx tools/export-hud.ts",
    "art": "tsx tools/build-art.ts",
    "check:maps": "tsx tools/check-maps.ts",
    "art:theodolite": "tsx tools/build-desk-theodolite.ts",
    "art:ground": "tsx tools/build-ground-atlas.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
